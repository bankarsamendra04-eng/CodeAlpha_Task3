# ===============================================
# AI Music Studio - Environment Configuration
# ===============================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dataset Configuration (Points to MAESTRO MIDI dataset directory)
DATASET_PATH=C:\path\to\maestro-v3.0.0-midi

# Database (SQLite for dev, easily swappable to PostgreSQL)
DATABASE_URL=sqlite:///./ai_music_studio.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_music_studio

# Generative AI (Groq API - used ONLY for prompt interpretation/intent extraction)
# Notice: Groq does NOT generate music/MIDI; our trained LSTM performs generation.
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Audio Rendering Engine (FluidSynth & SoundFonts)
# FLUIDSYNTH_PATH=C:\tools\fluidsynth\bin\fluidsynth.exe
# SOUNDFONT_PATH=C:\path\to\GeneralUser_GS.sf2