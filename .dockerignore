# ==============================================================================
# AI Music Studio — Docker Ignore Rules
# Guarantees that raw datasets, local secrets, caches, and dev dependencies
# are NEVER baked into Docker images.
# ==============================================================================

# 1. DATASETS (Crucial: Do NOT include the 1,276 MAESTRO files or raw MIDI in image)
dataset/
dataset/**
*.mid
*.midi
*.npz

# 2. SECRETS & CREDENTIALS (Crucial: Do NOT include .env or private keys)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/

# 3. LOCAL DATABASES & RUNTIME MEDIA OUTPUT
*.db
*.db-journal
*.db-wal
*.db-shm
output/
output/**
data/
data/**

# 4. PYTHON CACHE & TEST ARTIFACTS
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
env/
ENV/
.venv/

# 5. FRONTEND BUILD ARTIFACTS & DEPENDENCIES
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. VERSION CONTROL & IDE METADATA
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.gemini/
